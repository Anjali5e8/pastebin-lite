generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Paste {
  id            String    @id
  content       String
  max_views     Int?
  current_views Int       @default(0)
  expires_at    DateTime?
  createdAt     DateTime  @default(now())
}